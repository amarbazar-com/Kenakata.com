<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>আমার বাজার - অনলাইন শপিং</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; }
    :root {
      --primary-color: #25d366; --secondary-color: #075e54; --dark-color: #333;
      --accent-color: #e74c3c; --bg: #f8f9fa; --white: #fff; --shadow: rgba(0, 0, 0, 0.08);
    }
    html { scroll-behavior: smooth; }
    body { background: var(--bg); color: var(--dark-color); padding-bottom: 70px; }
    header { background: var(--white); position: sticky; top: 0; z-index: 1000; box-shadow: 0 2px 12px var(--shadow); }
    .header-container { max-width: 1200px; margin: 0 auto; padding: 15px 5%; display: flex; justify-content: space-between; align-items: center; }
    .logo { display: flex; align-items: center; gap: 10px; font-size: 24px; font-weight: 700; color: var(--secondary-color); }
    .nav-link-btn { text-decoration: none; color: var(--secondary-color); border: 1px solid var(--secondary-color); padding: 8px 16px; border-radius: 25px; font-weight: 600; transition: 0.3s ease; }
    .nav-link-btn:hover { background: var(--secondary-color); color: var(--white); }
    .hero-banner {
      background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)),
        url("https://images.unsplash.com/photo-1472851294608-062f824d29cc?w=1200") center/cover no-repeat;
      color: #fff; text-align: center; padding: 80px 20px;
    }
    .hero-banner h1 { font-size: clamp(28px, 4vw, 42px); margin-bottom: 10px; }
    .hero-banner p { font-size: 18px; opacity: 0.95; }
    .category-container { max-width: 1200px; margin: 30px auto; padding: 0 15px; }
    .category-tabs { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; margin-bottom: 25px; }
    .tab-btn { border: 2px solid var(--secondary-color); background: var(--white); color: var(--secondary-color); padding: 10px 20px; border-radius: 25px; font-size: 15px; font-weight: 700; cursor: pointer; transition: 0.3s ease; }
    .tab-btn.active, .tab-btn:hover { background: var(--secondary-color); color: var(--white); }
    .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; }
    .product-card { background: var(--white); border-radius: 12px; overflow: hidden; box-shadow: 0 6px 18px var(--shadow); transition: transform 0.3s ease; }
    .product-card:hover { transform: translateY(-5px); }
    .product-image { width: 100%; height: 220px; object-fit: cover; display: block; background: #f1f1f1; }
    .product-info { padding: 16px; }
    .product-title { font-size: 17px; font-weight: 700; color: #2c3e50; margin-bottom: 10px; min-height: 44px; }
    .price-box { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 15px; }
    .product-price { font-size: 19px; font-weight: 800; color: var(--accent-color); }
    .old-price { font-size: 14px; color: #888; text-decoration: line-through; }
    .order-btn { width: 100%; border: none; background: var(--primary-color); color: var(--white); padding: 12px 14px; border-radius: 8px; font-size: 15px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; transition: 0.3s ease; }
    .order-btn:hover { background: #1ea952; }
    .about-section { max-width: 1200px; margin: 40px auto 0; background: var(--white); border-radius: 12px; padding: 30px 20px; box-shadow: 0 6px 18px var(--shadow); }
    .about-section h2 { color: var(--secondary-color); display: inline-block; border-bottom: 2px solid var(--secondary-color); padding-bottom: 5px; margin-bottom: 18px; font-size: 24px; }
    .about-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
    .about-box { background: #f9f9f9; border-left: 4px solid var(--secondary-color); border-radius: 8px; padding: 18px; }
    .about-box h3 { font-size: 18px; margin-bottom: 10px; color: #333; }
    .about-box p { line-height: 1.7; color: #666; font-size: 14px; }
    .modal { position: fixed; inset: 0; background: rgba(0,0,0,0.6); display: none; justify-content: center; align-items: center; z-index: 2000; }
    .modal-content { position: relative; width: 90%; max-width: 500px; background: var(--white); border-radius: 12px; padding: 24px; max-height: 90vh; overflow-y: auto; }
    .close-modal { position: absolute; right: 16px; top: 10px; font-size: 28px; cursor: pointer; color: #444; }
    .modal-content h3 { margin-bottom: 16px; color: var(--secondary-color); font-size: 24px; }
    .modal-product-preview { background: #f9f9f9; border-radius: 8px; padding: 16px; margin-bottom: 20px; text-align: center; border: 1px solid #e0e0e0; }
    .modal-product-preview img { max-width: 100%; height: auto; border-radius: 6px; max-height: 220px; object-fit: cover; }
    .modal-product-info { margin-top: 12px; }
    .modal-product-name { font-size: 16px; font-weight: 700; color: #2c3e50; margin-bottom: 6px; }
    .modal-product-price { font-size: 18px; font-weight: 800; color: var(--accent-color); }
    .form-group { margin-bottom: 14px; }
    .form-group label { display: block; margin-bottom: 6px; font-weight: 600; font-size: 14px; }
    .form-group input, .form-group textarea { width: 100%; padding: 10px 12px; border: 1px solid #ddd; border-radius: 8px; font-size: 14px; }
    .floating-chat { position: fixed; right: 20px; bottom: 20px; background: var(--primary-color); color: var(--white); text-decoration: none; padding: 12px 18px; border-radius: 30px; font-weight: 700; box-shadow: 0 8px 18px rgba(37, 211, 102, 0.35); display: flex; align-items: center; gap: 10px; z-index: 1500; transition: 0.3s ease; }
    .floating-chat:hover { background: #1ea952; }
    .loading { text-align: center; padding: 40px 10px; color: #666; font-size: 18px; grid-column: 1 / -1; }
    @media (max-width: 600px) {
      .header-container { flex-direction: column; gap: 12px; }
      .modal-content { width: 95%; padding: 18px; }
    }
  </style>
</head>
<body>

  <header>
    <div class="header-container">
      <div class="logo"><i class="fa-solid fa-bag-shopping"></i> আমার বাজার</div>
      <div class="nav-links">
        <a href="#aboutSection" class="nav-link-btn"><i class="fa-solid fa-circle-info"></i> About Us</a>
      </div>
    </div>
  </header>

  <div class="hero-banner">
    <h1>আমাদের সেরা কালেকশন দেখুন</h1>
    <p>সরাসরি WhatsApp-এ সহজে অর্ডার করুন</p>
  </div>

  <div class="category-container">
    <div class="category-tabs" id="categoryTabs">
      <button class="tab-btn active" data-cat="all">সব প্রোডাক্ট</button>
      <button class="tab-btn" data-cat="men">Men (ছেলেদের)</button>
      <button class="tab-btn" data-cat="women">Women (মেয়েদের)</button>
      <button class="tab-btn" data-cat="kids">Kids (শিশুদের)</button>
    </div>

    <div class="product-grid" id="productGrid">
      <div class="loading"><i class="fa-solid fa-spinner fa-spin"></i> প্রোডাক্ট লোড হচ্ছে...</div>
    </div>
  </div>

  <div class="about-section" id="aboutSection">
    <h2><i class="fa-solid fa-store"></i> আমাদের সম্পর্কে (About Us)</h2>
    <div class="about-grid">
      <div class="about-box">
        <h3><i class="fa-solid fa-bullseye"></i> আমাদের লক্ষ্য</h3>
        <p>আমরা শতভাগ গুণগত মানসম্পন্ন ছেলেদের, মেয়েদের ও শিশুদের পোশাক ও প্রয়োজনীয় জিনিসপত্র সরবরাহ করি।</p>
      </div>
      <div class="about-box">
        <h3><i class="fa-solid fa-truck-fast"></i> ডেলিভারি প্রসেস</h3>
        <p>সারাদেশে ক্যাশ অন ডেলিভারিতে হোম ডেলিভারি দেওয়া হয়। ঢাকা সিটির ভেতর ১-২ দিন এবং বাইরে ৩-৫ দিনে ডেলিভারি পাবেন।</p>
      </div>
      <div class="about-box">
        <h3><i class="fa-solid fa-cart-shopping"></i> কীভাবে অর্ডার করবেন?</h3>
        <p>পছন্দের প্রোডাক্টের নিচে থাকা <b>"Order Now"</b> বাটনে ক্লিক করে আপনার নাম, মোবাইল নম্বর এবং ঠিকানা দিয়ে অর্ডার সাবমিট করুন।</p>
      </div>
    </div>
  </div>

  <div class="modal" id="orderModal">
    <div class="modal-content">
      <span class="close-modal" id="closeModalBtn">&times;</span>
      <h3>অর্ডার ফরম</h3>

      <div class="modal-product-preview">
        <img id="previewImg" src="" alt="Product" />
        <div class="modal-product-info">
          <div class="modal-product-name" id="previewName"></div>
          <div class="modal-product-price" id="previewPrice"></div>
        </div>
      </div>

      <form id="orderForm">
        <div class="form-group">
          <label>আপনার নাম:</label>
          <input type="text" id="custName" required placeholder="আপনার নাম" />
        </div>
        <div class="form-group">
          <label>মোবাইল নম্বর:</label>
          <input type="tel" id="custPhone" required placeholder="017XXXXXXXX" />
        </div>
        <div class="form-group">
          <label>সম্পূর্ণ ঠিকানা / লোকেশন:</label>
          <textarea id="custAddress" rows="2" required placeholder="বাসা নং, গ্রাম/রোড, থানা, জেলা"></textarea>
        </div>
        <div class="form-group">
          <label>ফেসবুক আইডি লিঙ্ক (Optional):</label>
          <input type="url" id="custFB" placeholder="https://facebook.com/yourid" />
        </div>
        <button type="submit" class="order-btn">
          <i class="fa-brands fa-whatsapp"></i> WhatsApp-এ অর্ডার করুন
        </button>
      </form>
    </div>
  </div>

  <a href="https://wa.me/8801891962606" target="_blank" rel="noopener" class="floating-chat">
    <i class="fa-brands fa-whatsapp" style="font-size: 20px;"></i>
    সরাসরি মেসেজ করুন
  </a>

  <script>
    const ADMIN_WHATSAPP = "8801891962606";

    // কত মিনিট পর ব্রাউজার নতুন ডেটা আনবে
    const REFRESH_MINUTES = 5;
    const FETCH_TIMEOUT_MS = 8000;
    const CACHE_KEY = "products_cache_v2";
    const PLACEHOLDER = "https://placehold.co/600x400/f0f0f0/333?text=No+Image";

    // ভিজিটরের ব্রাউজার শুধু নিজের সাইটের products.csv পড়ে।
    // Google Sheet-এ ভিজিটর কখনো রিকোয়েস্ট পাঠায় না।
    function getSources() {
      const bucket = Math.floor(Date.now() / (REFRESH_MINUTES * 60 * 1000));
      return [`products.csv?v=${bucket}`];
    }

    let allProducts = [];
    let currentCategory = "all";

    /* ---------- helpers ---------- */
    function escapeHTML(s) {
      return String(s).replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    }

    function toNumber(v) {
      if (v === undefined || v === null || v === "") return 0;
      const bn = "০১২৩৪৫৬৭৮৯";
      const s = String(v).replace(/[০-৯]/g, d => bn.indexOf(d)).replace(/[^\d.]/g, "");
      return Number(s) || 0;
    }

    function fixImageUrl(url) {
      if (!url) return PLACEHOLDER;
      url = url.trim();
      // Google Drive শেয়ার লিংক -> সরাসরি ছবি
      const m = url.match(/drive\.google\.com\/file\/d\/([^/]+)/) || url.match(/drive\.google\.com\/(?:open|uc)\?(?:.*&)?id=([^&]+)/);
      if (m) return `https://drive.google.com/thumbnail?id=${m[1]}&sz=w800`;
      if (!/^https?:\/\//i.test(url)) return PLACEHOLDER;
      return url;
    }

    /* ---------- সঠিক CSV parser (quote, comma, newline সব সামলায়) ---------- */
    function parseCSVRows(text) {
      text = text.replace(/^\uFEFF/, "");
      const rows = [];
      let row = [], field = "", inQuotes = false;
      for (let i = 0; i < text.length; i++) {
        const ch = text[i];
        if (inQuotes) {
          if (ch === '"') {
            if (text[i + 1] === '"') { field += '"'; i++; }
            else inQuotes = false;
          } else field += ch;
        } else {
          if (ch === '"') inQuotes = true;
          else if (ch === ",") { row.push(field); field = ""; }
          else if (ch === "\n") { row.push(field); rows.push(row); row = []; field = ""; }
          else if (ch === "\r") { /* skip */ }
          else field += ch;
        }
      }
      if (field !== "" || row.length) { row.push(field); rows.push(row); }
      return rows;
    }

    function parseProducts(csv) {
      const rows = parseCSVRows(csv);
      if (rows.length < 2) return null;
      const headers = rows[0].map(h => h.trim().toLowerCase());
      if (!headers.includes("name")) return null;

      const products = [];
      for (let i = 1; i < rows.length; i++) {
        const r = rows[i];
        if (!r.some(v => v.trim() !== "")) continue;
        const o = {};
        headers.forEach((h, idx) => { o[h] = (r[idx] || "").trim(); });
        if (!o.name) continue;
        const price = toNumber(o.price);
        const disc = toNumber(o.discount_price);
        products.push({
          name: o.name,
          category: (o.category || "all").toLowerCase().trim(),
          price: price,
          discount_price: disc > 0 ? disc : 0,
          img: fixImageUrl(o.img)
        });
      }
      return products;
    }

    /* ---------- fetch ---------- */
    async function fetchWithTimeout(url) {
      const ctrl = new AbortController();
      const t = setTimeout(() => ctrl.abort(), FETCH_TIMEOUT_MS);
      try {
        const res = await fetch(url, { signal: ctrl.signal });
        if (!res.ok) throw new Error("HTTP " + res.status);
        return await res.text();
      } finally {
        clearTimeout(t);
      }
    }

    let lastError = "";

    async function loadFresh() {
      for (const url of getSources()) {
        try {
          const text = await fetchWithTimeout(url);
          const products = parseProducts(text);
          if (products && products.length) return products;
          lastError = "products.csv পাওয়া গেছে কিন্তু ভেতরে কোনো প্রোডাক্ট নেই (হেডারে name, category, price, discount_price, img আছে কিনা দেখুন)";
        } catch (e) {
          lastError = location.protocol === "file:"
            ? "ফাইলটি কম্পিউটার থেকে সরাসরি খোলা হয়েছে। অনলাইন সাইট (GitHub Pages) থেকে খুলুন"
            : "products.csv লোড হয়নি (" + e.message + ")। GitHub repo-তে products.csv আছে কিনা দেখুন";
          console.warn("Source failed:", url, e.message);
        }
      }
      return null;
    }

    /* ---------- render ---------- */
    function displayProducts(items) {
      const grid = document.getElementById("productGrid");
      if (!items || items.length === 0) {
        grid.innerHTML = '<p class="loading">কোনো প্রোডাক্ট পাওয়া যায়নি!</p>';
        return;
      }

      grid.innerHTML = items.map(p => {
        const hasDisc = p.discount_price > 0 && p.discount_price !== p.price;
        const price = hasDisc ? p.discount_price : p.price;
        const idx = allProducts.indexOf(p);
        return `
          <div class="product-card">
            <img src="${escapeHTML(p.img)}" class="product-image" alt="${escapeHTML(p.name)}" loading="lazy" referrerpolicy="no-referrer" data-fallback="1">
            <div class="product-info">
              <div class="product-title">${escapeHTML(p.name)}</div>
              <div class="price-box">
                <span class="product-price">৳ ${price}</span>
                ${hasDisc ? `<span class="old-price">৳ ${p.price}</span>` : ""}
              </div>
              <button class="order-btn" data-index="${idx}">
                <i class="fa-brands fa-whatsapp"></i> Order Now
              </button>
            </div>
          </div>`;
      }).join("");

      // ছবি লোড না হলে placeholder
      grid.querySelectorAll("img[data-fallback]").forEach(img => {
        img.addEventListener("error", () => { img.src = PLACEHOLDER; }, { once: true });
      });
    }

    function renderCurrent() {
      const list = currentCategory === "all" ? allProducts : allProducts.filter(p => p.category === currentCategory);
      displayProducts(list);
    }

    /* ---------- init: cache আগে দেখাও, পিছনে fresh ডেটা আনো ---------- */
    async function init() {
      let cached = null;
      try {
        const raw = localStorage.getItem(CACHE_KEY);
        if (raw) cached = JSON.parse(raw);
      } catch (_) {}

      if (cached && cached.products && cached.products.length) {
        allProducts = cached.products;
        renderCurrent();
      }

      const fresh = await loadFresh();
      if (fresh) {
        const changed = JSON.stringify(fresh) !== JSON.stringify(allProducts);
        allProducts = fresh;
        try { localStorage.setItem(CACHE_KEY, JSON.stringify({ time: Date.now(), products: fresh })); } catch (_) {}
        if (changed) renderCurrent();
      } else if (!allProducts.length) {
        document.getElementById("productGrid").innerHTML =
          '<p class="loading">প্রোডাক্ট লোড করতে সমস্যা হয়েছে। দয়া করে কিছুক্ষণ পর আবার চেষ্টা করুন।<br><small style="font-size:12px;color:#999">' + escapeHTML(lastError) + '</small></p>';
      }
    }

    /* ---------- category ---------- */
    document.getElementById("categoryTabs").addEventListener("click", e => {
      const btn = e.target.closest(".tab-btn");
      if (!btn) return;
      document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      currentCategory = btn.dataset.cat;
      renderCurrent();
    });

    /* ---------- order modal ---------- */
    let selected = null;

    document.getElementById("productGrid").addEventListener("click", e => {
      const btn = e.target.closest(".order-btn");
      if (!btn) return;
      const p = allProducts[Number(btn.dataset.index)];
      if (p) openOrderModal(p);
    });

    function openOrderModal(p) {
      const hasDisc = p.discount_price > 0 && p.discount_price !== p.price;
      selected = { name: p.name, price: hasDisc ? p.discount_price : p.price, oldPrice: hasDisc ? p.price : "", img: p.img };

      const img = document.getElementById("previewImg");
      img.src = p.img;
      img.onerror = () => { img.src = PLACEHOLDER; };
      document.getElementById("previewName").textContent = p.name;
      let t = `৳ ${selected.price}`;
      if (selected.oldPrice) t += ` (আগের দাম: ৳ ${selected.oldPrice})`;
      document.getElementById("previewPrice").textContent = t;

      document.getElementById("orderModal").style.display = "flex";
    }

    function closeOrderModal() {
      document.getElementById("orderModal").style.display = "none";
    }

    document.getElementById("closeModalBtn").addEventListener("click", closeOrderModal);
    document.getElementById("orderModal").addEventListener("click", e => {
      if (e.target.id === "orderModal") closeOrderModal();
    });
    document.addEventListener("keydown", e => { if (e.key === "Escape") closeOrderModal(); });

    document.getElementById("orderForm").addEventListener("submit", e => {
      e.preventDefault();
      if (!selected) return;

      const name = document.getElementById("custName").value.trim();
      const phone = document.getElementById("custPhone").value.trim();
      const address = document.getElementById("custAddress").value.trim();
      const fb = document.getElementById("custFB").value.trim();

      const bn = "০১২৩৪৫৬৭৮৯";
      const phoneEn = phone.replace(/[০-৯]/g, d => bn.indexOf(d)).replace(/[\s-]/g, "");
      if (!/^(?:\+?88)?01[3-9]\d{8}$/.test(phoneEn)) {
        alert("সঠিক মোবাইল নম্বর দিন (যেমন: 01712345678)");
        return;
      }

      let priceDetails = `৳ ${selected.price}`;
      if (selected.oldPrice) priceDetails += ` (আগের দাম: ৳ ${selected.oldPrice})`;

      let msg = `🛍️ *নতুন প্রোডাক্ট অর্ডার*

📦 *প্রোডাক্টের তথ্য*
━━━━━━━━━━━━━━━━
*প্রোডাক্ট:* ${selected.name}
*মূল্য:* ${priceDetails}
*ছবি লিঙ্ক:* ${selected.img}

👤 *কাস্টমারের তথ্য*
━━━━━━━━━━━━━━━━
*নাম:* ${name}
*ফোন নম্বর:* ${phoneEn}
*ঠিকানা:* ${address}`;

      if (fb) msg += `\n*ফেসবুক:* ${fb}`;
      msg += `\n\n✅ অনুগ্রহ করে অর্ডারটি কনফার্ম করুন।`;

      window.open(`https://wa.me/${ADMIN_WHATSAPP}?text=${encodeURIComponent(msg)}`, "_blank");
      closeOrderModal();
      e.target.reset();
    });

    init();
  </script>
</body>
</html>
